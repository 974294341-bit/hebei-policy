/* 详情页样式 */
.page { padding: 24rpx 30rpx 60rpx; }
.tip { text-align: center; color: #a5aebc; padding: 120rpx 0; font-size: 28rpx; }

.d-head { background: #fff; border-radius: 16rpx; padding: 34rpx 30rpx; }
.d-title { font-size: 34rpx; font-weight: bold; line-height: 1.6; color: #1a1a1a; }
.d-tags { margin-top: 18rpx; display: flex; align-items: center; gap: 16rpx; }
.d-tag {
  font-size: 22rpx; color: #1454a8; background: #eef4ff;
  padding: 4rpx 18rpx; border-radius: 20rpx; border: 1rpx solid #dbe7fb;
}
.d-date { font-size: 24rpx; color: #9aa3b2; }

.d-meta {
  margin-top: 20rpx; background: #fff; border-radius: 16rpx; padding: 10rpx 30rpx;
}
.m-row {
  display: flex; padding: 16rpx 0; font-size: 26rpx;
  border-bottom: 1rpx solid #f2f5fa;
}
.m-row:last-child { border-bottom: none; }
.m-k { width: 150rpx; color: #8a94a6; flex-shrink: 0; }
.m-v { flex: 1; color: #333; }

.d-body {
  margin-top: 20rpx; background: #fff; border-radius: 16rpx;
  padding: 30rpx; font-size: 29rpx; line-height: 1.9; color: #333;
  word-break: break-word;
}
.d-empty { text-align: center; color: #a5aebc; padding: 60rpx 0; }
